    <script>
        // QFRemote 登录通道（网页通道内）：全部登录提交改走自家登录通道（/qf-login），
        // 通道负责「记住此设备」保鲜 + 登录冻结计数/申诉拦截；勾选「记住此设备」时
        // 通道给会话 cookie 加 30 天有效期并留下标记，后续流量由通道保鲜；
        // 不勾选提交时先清掉旧标记（会话级登录，关浏览器即失效）。
        // 直连 8443（软件壳内）时不改道，维持 MeshCentral 原生提交。
        (function () {
            var viaShim = location.port !== '8443';
            function qfSetRoute() {
                var form = document.getElementById('loginpanelform');
                if (!form) return;
                if (viaShim) { form.action = '/qf-login'; }
                else { form.removeAttribute('action'); }
            }
            function qfApplyRemember() {
                var box = document.getElementById('qfRememberDevice');
                qfSetRoute();
                if (viaShim && box && !box.checked) {
                    document.cookie = 'qfrem=; Path=/; Max-Age=0; Secure; SameSite=Lax';
                }
            }
            document.addEventListener('DOMContentLoaded', function () {
                qfSetRoute();
                var row = document.getElementById('qfAppealStatusRow');
                if (row && viaShim) row.style.display = '';
                var srow = document.getElementById('qfSupportRow');
                if (srow && viaShim) srow.style.display = '';
                var box = document.getElementById('qfRememberDevice');
                if (box) box.addEventListener('change', qfApplyRemember);
                var btn = document.getElementById('loginButton');
                if (btn) btn.addEventListener('pointerdown', qfApplyRemember);
            });
            // 捕获阶段兜底：鼠标、回车、脚本触发的点击都会在提交前先同步一次
            document.addEventListener('click', function (e) {
                if (e.target && e.target.id === 'loginButton') { qfApplyRemember(); qfHandleCredsOnLogin(); }
            }, true);

            // ===== 2.3.0「记住账号密码」＋会话失效自动恢复（网页端） =====
            // 保存方式：账号明文只记在本机浏览器的 localStorage（账号本身不是
            // 秘密）；密码不经本站页面代码落任何本地存储，而是交给浏览器自带
            // 的密码管理器保存（PasswordCredential），下次由浏览器回填/取回。
            // 浏览器不支持密码管理器接口时，只记账号，密码靠「记住此设备」
            // 的 30 天会话恢复，不另存密码。
            // 手动退出时控制台注入脚本会清掉这里的保存并打标记（qfJustLoggedOut），
            // 本页见到标记先清凭据、本次不自动恢复；取消勾选后再登录也清。
            var QF_CRED_USER = 'qfCredUser', QF_CRED_ON = 'qfCredOn', QF_TRIED = 'qfAutoTried', QF_CRED_PASS = 'qfCredPass';
            function qfLs(k, v) { try { if (v === undefined) return localStorage.getItem(k); if (v === null) localStorage.removeItem(k); else localStorage.setItem(k, v); } catch (e) { return null; } }
            function qfSs(k, v) { try { if (v === undefined) return sessionStorage.getItem(k); if (v === null) sessionStorage.removeItem(k); else sessionStorage.setItem(k, v); } catch (e) { return null; } }
            function qfCredApi() { try { return (navigator.credentials && typeof PasswordCredential !== 'undefined') ? navigator.credentials : null; } catch (e) { return null; } }
            function qfClearCreds() {
                qfLs(QF_CRED_USER, null); qfLs(QF_CRED_ON, null); qfLs(QF_CRED_PASS, null);
                var c = qfCredApi();
                if (c && c.preventSilentAccess) { try { var r = c.preventSilentAccess(); if (r && r.catch) r.catch(function () {}); } catch (e) {} }
            }
            function qfHandleCredsOnLogin() {
                var box = document.getElementById('qfRememberCreds');
                var uEl = document.getElementById('username');
                var pEl = document.getElementById('password');
                if (!box || !uEl || !pEl) return;
                if (!box.checked) { qfClearCreds(); return; }
                var u = uEl.value || '', pw = pEl.value || '';
                if (!u) return;
                qfLs(QF_CRED_USER, u); qfLs(QF_CRED_ON, '1');
                var c = qfCredApi();
                if (c && pw) {
                    try { var r = c.store(new PasswordCredential({ id: u, password: pw, name: u })); if (r && r.catch) r.catch(function () {}); } catch (e) {}
                    qfLs(QF_CRED_PASS, null); // 有密码管理器时不留本地密码副本
                } else if (!c && pw) {
                    // Safari 等不支持 PasswordCredential 的浏览器：与新控制台（SPA）#39 同口径，
                    // 密码只存本机浏览器 localStorage，下次回填并自动登录。
                    qfLs(QF_CRED_PASS, pw);
                }
            }
            function qfAutoRestore() {
                if (qfSs('qfJustLoggedOut') === '1') {
                    qfSs('qfJustLoggedOut', null);
                    // 与新控制台口径对齐：手动退出只结束会话，不清已保存的账密；
                    // 本次只回填、不自动提交，用户点「登录」即进。
                    if (qfLs(QF_CRED_ON) === '1') {
                        var b2 = document.getElementById('qfRememberCreds'); if (b2) b2.checked = true;
                        var u2 = document.getElementById('username'); var su = qfLs(QF_CRED_USER);
                        if (u2 && su && !u2.value) u2.value = su;
                        var p2 = document.getElementById('password'); var sp0 = qfLs(QF_CRED_PASS);
                        if (p2 && sp0 && !p2.value) { p2.value = sp0; if (typeof validateLogin === 'function') { try { validateLogin(1); validateLogin(2); } catch (e) {} } }
                    }
                    return;
                }
                if (qfLs(QF_CRED_ON) !== '1') return;
                var box = document.getElementById('qfRememberCreds');
                if (box) box.checked = true;
                var uEl = document.getElementById('username');
                var savedUser = qfLs(QF_CRED_USER);
                if (uEl && savedUser && !uEl.value) uEl.value = savedUser;
                // 上一轮自动登录失败会带着错误提示回到本页：给一句话说明，不再重试防死循环
                var msg = document.getElementById('message1');
                if (qfSs(QF_TRIED) === '1') {
                    if (msg && msg.textContent) { var h = document.getElementById('qfAutoHint'); if (h) h.style.display = 'block'; }
                    return;
                }
                var c = qfCredApi();
                if (!c || !c.get) {
                    // 无密码管理器接口（Safari）：用本地保存的密码回填并自动登录
                    var sp2 = qfLs(QF_CRED_PASS);
                    var pEl2 = document.getElementById('password');
                    var btn2 = document.getElementById('loginButton');
                    if (sp2 && uEl && pEl2 && btn2 && uEl.value) {
                        pEl2.value = sp2;
                        if (typeof validateLogin === 'function') { try { validateLogin(1); validateLogin(2); } catch (e) {} }
                        qfSs(QF_TRIED, '1');
                        btn2.click();
                    }
                    return;
                }
                try {
                    var pr = c.get({ password: true, mediation: 'silent' });
                    if (!pr || !pr.then) return;
                    pr.then(function (cred) {
                        if (!cred || !cred.id || !cred.password) return;
                        var pEl = document.getElementById('password');
                        var btn = document.getElementById('loginButton');
                        if (!uEl || !pEl || !btn) return;
                        uEl.value = cred.id; pEl.value = cred.password;
                        if (typeof validateLogin === 'function') { try { validateLogin(1); validateLogin(2); } catch (e) {} }
                        qfSs(QF_TRIED, '1');
                        btn.click();
                    }).catch(function () {});
                } catch (e) {}
            }
            window.addEventListener('load', function () { setTimeout(qfAutoRestore, 400); });
            // 用户手动改动账号/密码后，允许下一次再自动恢复一次
            document.addEventListener('input', function (e) {
                if (e.isTrusted && e.target && (e.target.id === 'username' || e.target.id === 'password')) qfSs(QF_TRIED, null);
            }, true);
        })();
    </script>
</body>
</html>
