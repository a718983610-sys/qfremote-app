    # 引擎功能路径（/meshagents、/meshsettings 缺失会断新装 agent，E6 实测）
    # 步3验收修复1（2026-10-30）：出厂 SPA 会话帧基址 QF_CANON_ORIGIN=/console-engine
    # （app.js sessionDeepLink/preheat 均以 /console-engine/?... 入框），翻牌 X2 误删致帧 404；
    # 按翻牌前原块恢复（上游改用合并图的 $qf_root_final：qfrem=1 走垫片、余直达引擎）。
    location /console-engine/ {
        rewrite ^/console-engine/(.*)$ /$1 break;
        proxy_pass $qf_console_upstream;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_buffering off;
        proxy_set_header User-Agent $qf_ce_ua;
        include /etc/nginx/qf-front-proxy-common.inc;
        # IP passthrough fix 2026-11-12: override include's X-Real-IP ($remote_addr is
        # 127.0.0.1 via cloudflared) and X-Forwarded-For with the trusted real client
        # IP; drop any client-supplied XFF/X-Real-IP (forgery risk). Later header wins.
        proxy_set_header X-Real-IP $qf_real_ip;
        proxy_set_header X-Forwarded-For $qf_real_ip;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-Proto https;
    }

    location = /console-engine {
