# === DESKTOP-AUTH evidence log (2026-10-28, per DeepSeek gate-1) ===
# Flags only; cookie values are NEVER logged. Read: WS has_xid=0 -> egress strips cookies (H3);
# dup_xid=1 -> duplicate xid (H1); full single xid but still noauth -> inspect server session rules.
# Rollback: restore .bak-cookielog-20261028 then reload nginx.
map $http_cookie $qf_has_xid   { default 0; "~(^|;\s*)xid=" 1; }
map $http_cookie $qf_has_sig   { default 0; "~(^|;\s*)xid\.sig=" 1; }
map $http_cookie $qf_has_qfrem { default 0; "~(^|;\s*)qfrem=" 1; }
map $http_cookie $qf_dup_xid   { default 0; "~(^|;\s*)xid=[^;]*;.*;\s*xid=" 1; }
log_format qfcookie '$time_iso8601 "$uri" $status bytes=$bytes_sent has_xid=$qf_has_xid has_sig=$qf_has_sig has_qfrem=$qf_has_qfrem dup_xid=$qf_dup_xid ua="$http_user_agent"';
# Diagnostic log for Host/Origin/IP chain (2026-11-12, temporary; headers + flags only, NO cookie values).
log_format qfdiag '$time_iso8601 "$request" $status bytes=$bytes_sent host="$http_host" xff="$http_x_forwarded_for" xrip="$http_x_real_ip" cfip="$http_cf_connecting_ip" up="$upstream_addr" up_status="$upstream_status" referer="$http_referer" has_xid=$qf_has_xid has_sig=$qf_has_sig has_qfrem=$qf_has_qfrem';

# QFRemote 临时通道本机反代：只听回环，cloudflared 快速隧道只对它开口。
# / 及全部路径 -> MeshCentral 控制台(8443)；/register 与 /api/register -> 注册服务(8444)。
# 记住此设备（控制台面）：带 qfrem=1 标记的请求改走登录垫片(8450)通用转发，
# 由垫片在回程给会话 cookie(xid) 续上 30 天有效期，防被控制台后续响应冲成会话级；
# 无标记的请求维持直达 MeshCentral(8443) 现行行为。
map $cookie_qfrem $qf_console_upstream {
    default https://127.0.0.1:8443;
    "1"     http://127.0.0.1:8450;
}

# Real client IP for console-engine shim chain (2026-11-12 IP passthrough fix):
# prefer Cloudflare CF-Connecting-IP; fall back to first non-127.0.0.1 XFF entry.
# (nginx sees cloudflared on 127.0.0.1, so $remote_addr is useless here.)
map $http_cf_connecting_ip $qf_real_ip {
    default $http_cf_connecting_ip;
    ""      $qf_xff_real_ip;
}
map $http_x_forwarded_for $qf_xff_real_ip {
    default $http_x_forwarded_for;
    "~^(?:127\.0\.0\.1,\s*)*([^,\s]+)" $1;
}

