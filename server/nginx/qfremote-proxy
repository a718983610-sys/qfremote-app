    # 原生登录面分流（2.4.0 翻牌，X1，BUILD-20261029/fronting 定版 B 式）：站长→引擎登录面
    # （B 式例外直达原生）；其余→丙段弹跳 302 回 SPA 登录。取代 #33 一律 302 口径的隧道源部分；
    # 8443 直连源 /login 不在此列（正当登录面，不动）。
    location = /login {
        auth_request /_qf_whoami;
        auth_request_set $qf_role_raw $upstream_http_x_qf_role;
        proxy_pass $qf_login_upstream;
        proxy_redirect off;
        error_page 500 502 503 504 = @qf_spa_failsafe;
        include qf-front-proxy-common.inc;
    }

    # 前置分流主入口（2.4.0 翻牌，BUILD-20261029/fronting 定版 B 式）：
    # 角色子请求回填 $qf_role_raw，map 在内容阶段求值分流——站长例外整页直达引擎、
    # 框内会话入场→引擎、非站长命中原生页→弹跳 302 回 SPA、其余→SPA 聚合（8082）。
    # whoami 故障 fail-soft：变量为空→anon→落 SPA（条 17 定案）。
    # 条 20：框内入场（含预热 qfm=warm）文档请求改写桌面 UA（E8 实证移动 UA 变体不可用）。
    location = / {
        auth_request /_qf_whoami;
        auth_request_set $qf_role_raw $upstream_http_x_qf_role;
        proxy_pass $qf_root_final;
        proxy_redirect off;
        error_page 500 502 503 504 = @qf_spa_failsafe;
        proxy_set_header User-Agent $qf_frame_ua;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        include qf-front-proxy-common.inc;
    }

    # 条 17 fail-soft 落点（组装故障注入实测后补）：whoami 子请求故障（上游断/超时）
    # 时 auth_request 以 500 中止主请求，此处截获改落 SPA 聚合——故障期根路径与登录面
    # 落 SPA 非 5xx（站长例外在故障期失效、可用性优先，与定案口径一致）。
    location @qf_spa_failsafe {
        proxy_pass http://qf_spa_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # ===== 引擎面（2.4.0 翻牌，片段乙段）：会话运行时资产与数据面 =====
    # 角色子请求端点（内部，不对外；组装步 1 已在 loginshim 落地 whoami，契约恒 200+X-QF-Role）
    location = /_qf_whoami {
        internal;
        proxy_pass http://127.0.0.1:8450;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 1s;
        proxy_send_timeout 1s;
        proxy_read_timeout 1s;
    }

    # 引擎静态前缀集（条 2 实测全集；/translations/ 为组装保全项：原生登录页译文资产，非页面面）
    location /scripts/ { proxy_pass $qf_engine_upstream; include qf-front-proxy-common.inc; }
    location /styles/ { proxy_pass $qf_engine_upstream; include qf-front-proxy-common.inc; }
    location /images/ { proxy_pass $qf_engine_upstream; include qf-front-proxy-common.inc; }
